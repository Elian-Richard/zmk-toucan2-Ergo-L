#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define SYM  1
#define NAV  2
// #define ADJ  3

/ {

    combos {
        compatible = "zmk,combos";

        unlock {
            bindings = <&studio_unlock>;
            key-positions = <0 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB   &kp A &kp C &kp O  &kp P &kp Z  &kp J         &kp SEMI &kp D &none &kp Y &kp DEL  
                &kp LSHFT &kp Q &kp S &kp E  &kp N &kp F  &kp L         &kp R    &kp T &kp I &kp U &kp LALT  
                &kp LCTRL &kp W &kp X &kp N6 &kp V &kp B  &kp LS(COMMA) &kp H    &kp G &kp M &kp K &kp LGUI  
                                 &mo 2 &kp SPACE &kp RET  &kp BSPC &kp LSHFT &mo 1
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
&ESC   &kp RA(N9) &kp LESS_THAN &kp GREATER_THAN &kp DLLR      &kp PRCNT   &kp F2 &kp F4 &none &kp LG(PERIOD)  &none            &trans  
&trans &kp RA(N4) &kp N5        &kp MINUS        &kp RA(EQUAL) &trans      &kp F5 &kp F8 &none &kp LG(APOS)    &kp LG(E)        &trans  
&trans &kp RA(N2) &kp RA(N5)    &kp RA(MINUS)    &kp N8        &kp RA(N3)  &none  &none  &none &kp PRINTSCREEN &kp K_CALCULATOR &trans  
                                          &trans &kp LC(LS(SPACE)) &trans  &trans &trans &trans
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
&trans &kp LC(S) &kp LG(LS(LEFT)) &kp UP    &kp LG(LS(RIGHT)) &kp LG(UP)    &kp KP_PLUS  &kp LS(N7) &kp LS(N8) &kp LS(N9) &kp KP_MULTIPLY &trans  
&trans &kp LC(W) &kp LEFT         &kp DOWN  &kp RIGHT         &kp LG(DOWN)  &kp KP_MINUS &kp LS(N4) &kp LS(N5) &kp LS(N6) &kp KP_DIVIDE   &trans  
&trans &kp LC(Y) &kp LC(X)        &kp LC(C) &kp LC(V)         &kp LG(V)     &kp KP_DOT   &kp LS(N1) &kp LS(N2) &kp LS(N3) &kp KP_EQUAL    &trans  
                                                      &trans &trans &trans  &trans &trans &trans
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
               &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans  
               &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans  
               &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans  
               &mkp MCLK &mkp LCLK &mkp RCLK                  &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
