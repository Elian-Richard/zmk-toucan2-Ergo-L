#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <2 1>;
            then-layer = <3>;
        };
    };

    combos {
        compatible = "zmk,combos";

        unlock {
            bindings = <&studio_unlock>;
            key-positions = <0 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
&kp TAB  &kp A  &kp C  &kp O  &kp P  &kp Z  &kp J  &kp SEMI  &kp D  &none  &kp Y  &kp DELETE  &kp LSHFT  &kp Q  &kp S  &kp E  &kp N  &kp F  &kp L  &kp R  &kp T  &kp I  &kp U  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp W  &kp X  &kp NUMBER_6  &kp V  &kp B  &kp LS(COMMA)  &kp H  &kp G  &kp M  &kp K  &kp LEFT_GUI  &mo 2  &kp SPACE  &kp RETURN  &kp BACKSPACE  &kp LEFT_SHIFT  &mo 1
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
&trans  &kp RA(N9)  &kp LESS_THAN  &kp GREATER_THAN  &kp DLLR  &kp PRCNT  &kp F2  &kp F4  &none  &kp LG(PERIOD)  &none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F5  &kp F8  &none  &kp LG(APOS)  &kp LG(E)  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none  &none  &none  &kp PRINTSCREEN  &kp K_CALCULATOR  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
&trans  &kp LC(S)  &kp LG(LS(LEFT_ARROW))  &kp UP_ARROW  &kp LG(LS(RIGHT_ARROW))  &kp LG(UP_ARROW)  &kp KP_PLUS  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_MULTIPLY  &trans  &trans  &kp LC(W)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LG(DOWN_ARROW)  &kp KP_MINUS  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_DIVIDE  &trans  &trans  &kp LC(Y)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LG(V)  &kp KP_DOT  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_EQUAL  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
&mo 0  &trans  &kp F7  &kp F8  &kp F9  &kp F12  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &trans  &trans  &kp BSPC  &kp LCTRL  &trans  &kp F4  &kp F5  &kp F6  &kp F11  &trans  &trans  &trans  &trans  &trans  &trans  &bt LSHFT  &trans  &kp F1  &kp F2  &kp F3  &kp F10  &trans  &trans  &trans  &trans  &trans  &trans  &kp LGUI  &mo 2  &kp SPACE  &kp RET  &mo 1  &kp RALT
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MCLK  &mkp LCLK  &mkp RCLK  &mkp LCLK  &mkp RCLK  &mkp MCLK
            >;
        };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
